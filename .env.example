# ==========================================
# DevPilot Environment Configuration Template
# ==========================================

# -----------------
# Database (MySQL)
# -----------------
DB_URL=jdbc:mysql://localhost:3307/devpilot
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# -----------------
# Groq AI & LLM
# -----------------
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=text-embedding-3-small

# -----------------
# GitHub OAuth 2.0
# -----------------
# Create at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# -----------------
# Qdrant Vector DB
# -----------------
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=devpilot_code
QDRANT_USE_TLS=false
QDRANT_API_KEY=

# -----------------
# Application Security
# -----------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TOKEN_ENCRYPTOR_PASSWORD=devpilot-secure-encryption-key
TOKEN_ENCRYPTOR_SALT=deadbeefcafebabe

# -----------------
# Frontend (client/.env)
# -----------------
VITE_API_BASE_URL=http://localhost:8080
